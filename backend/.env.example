# ============================================================
#  Copiar a .env y completar:   cp .env.example .env
#  El archivo .env NO se sube al repositorio (está en .gitignore).
# ============================================================

# ---- Base de datos (PostgreSQL) ----
# Opción A: una sola URL (Neon, Render, etc.)
# DATABASE_URL=postgresql://usuario:clave@host/base?sslmode=require
# PGSSL=true   <- obligatorio con Neon. El sslmode de la URL no alcanza: el código fija el
#                cifrado según esta variable, y sin ella la conexión va sin cifrar y Neon la rechaza.
# Opción B: datos sueltos (PostgreSQL local)
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=cambiar-esta-clave
PGDATABASE=control_trama

# ---- Servidor ----
PORT=3000
NODE_ENV=development
# true si hay un proxy delante (Nginx, Render...). En Render se activa solo.
TRUST_PROXY=false
# Dominios que pueden llamar a la API desde otro origen, separados por coma.
# La web se sirve desde este mismo servidor, así que normalmente se deja vacío.
CORS_ORIGIN=

# ---- Seguridad de la API (OBLIGATORIAS en producción) ----
# Clave para firmar las cookies de sesión de los operarios (mínimo 32 caracteres).
# Generarla con:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Duración de la sesión en horas (una jornada = 12).
SESSION_HORAS=12
# Clave que cifra los códigos de recuperación guardados en la base (mínimo 16
# caracteres). Sin ella, en producción el servidor no arranca. Si se cambia, los
# códigos guardados dejan de leerse: rotarlos con  npm run codigo <usuario> --rotar
# Generarla igual que SESSION_SECRET.
RECOVERY_SECRET=
# Clave compartida con los ESP32: debe ser IGUAL a DEVICE_KEY en config.h del Nivel 1
# y en config_nivel2.h del Nivel 2. Generarla igual que la anterior.
ESP32_DEVICE_KEY=
# Cuántos usuarios se registran libres; del siguiente en adelante hace falta un código
# de invitación de un usuario ya registrado.
REGISTRO_LIBRE_MAX=3
# Intentos de login/recuperación por IP cada 15 minutos.
AUTH_INTENTOS_MAX=20
# Límite general de pedidos a la API, por usuario (por IP antes de iniciar sesión).
# La web consulta el estado cada 4 s: no bajar de 900 cada 15 minutos.
# RATE_LIMIT_MAX=900
# RATE_LIMIT_WINDOW_MS=900000
# Máximo de conexiones simultáneas a la base (el plan gratuito de Neon tiene un tope bajo).
# PG_POOL_MAX=10

# ---- Login por huella (WebAuthn) ----
# En producción, fijar el dominio real (sin esto, se toma del pedido y se debilita la
# protección anti-phishing). Requiere HTTPS.
# WEBAUTHN_RP_ID=control-trama-backend.onrender.com
# WEBAUTHN_ORIGIN=https://control-trama-backend.onrender.com
